---
import {
  contributionLabels,
  type Locale,
  type Publication,
} from '../content/site';
type Props = { items: Publication[]; locale?: Locale };
const { items, locale = 'en' } = Astro.props;
---

<div class="publication-list">
  {
    items.map((publication) => (
      <article class="publication-item">
        <>
          <div class="publication-year">{publication.year}</div>
          <div>
            <>
              <h3>
                <a href={publication.href}>{publication.title}</a>
              </h3>
              <p class="publication-authors">{publication.authors}</p>
              <p class="publication-meta">
                <>
                  <span>{publication.venue}</span>
                  <span>
                    {contributionLabels[locale][publication.contribution]}
                  </span>
                </>
              </p>
            </>
          </div>
        </>
      </article>
    ))
  }
</div>
