---
import PublicationList from '../components/PublicationList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import { publications, siteContent } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
const { focusAreas, profile, selectedWork } = siteContent.en;
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow">Graphics systems · Physical oceanography</p>
      <h1>{profile.name}</h1>
      <p class="hero-lead">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button primary" href="/work/">Explore selected work</a><a
          class="button secondary"
          href="/publications/">Read publications</a
        >
      </div>
      <div class="hero-meta">
        <span>{profile.nameZh}</span><span>{profile.location}</span>
      </div>
    </div>
    <div class="hero-index" aria-label="Research areas">
      {
        focusAreas.map((area) => (
          <article>
            <p>{area.eyebrow}</p>
            <div>
              <h2>{area.title}</h2>
              <span>{area.description}</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div class="home-work-strip page-shell" aria-label="Selected work summary">
    <span>Selected work</span>
    {selectedWork.map((item) => <strong>{item.title}</strong>)}
  </div>

  <section class="section section-tint" aria-labelledby="work-heading">
    <div class="page-shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Public work across graphics and ocean science"
        description="A deliberately small selection of public products and peer-reviewed research."
      />
      <div class="work-grid" id="work-heading">
        {
          selectedWork.map((item, index) => (
            <WorkCard item={item} index={index} />
          ))
        }
      </div>
      <a class="text-link section-link" href="/work/"
        >View the work archive <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="publications-heading">
    <SectionHeading
      eyebrow="Research"
      title="Recent publications"
      description={`The complete publication record contains ${publications.length} peer-reviewed papers.`}
    />
    <div id="publications-heading">
      <PublicationList items={publications.slice(0, 5)} />
    </div>
    <a class="text-link section-link" href="/publications/"
      >View all selected publications <span aria-hidden="true">→</span></a
    >
  </section>

  <section class="closing-statement">
    <div class="page-shell">
      <p class="eyebrow">Working principle</p><blockquote>
        Understand the physical system. Define the contract. Measure the
        evidence.
      </blockquote><div class="closing-links">
        {
          profile.links.map((link) => (
            <a href={link.href}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
