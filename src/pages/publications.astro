---
import PublicationList from '../components/PublicationList.astro';
import { publications, siteContent } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
const { profile } = siteContent.en;
const orcid = profile.links.find((link) => link.label === 'ORCID')?.href;
---

<BaseLayout
  title="Publications · Zelun Wu"
  description={`Complete peer-reviewed publication record for Zelun Wu: ${publications.length} papers.`}
>
  <header class="page-intro page-shell">
    <p class="eyebrow">Publications</p><h1>Complete research record</h1><p>
      {publications.length} peer-reviewed publications spanning ocean carbon, remote
      sensing, physical oceanography, and machine-learning reconstruction.
    </p>{
      orcid && (
        <a class="text-link" href={orcid}>
          Open ORCID <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </header>
  <section class="section page-shell">
    <PublicationList items={publications} />
  </section>
</BaseLayout>
