---
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import { education, experience, profile } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About · Zelun Wu"
  description={`About ${profile.name}, ${profile.headline}.`}
>
  <header class="page-intro page-shell about-intro">
    <div>
      <p class="eyebrow">About</p><h1>
        {profile.name}<br /><span>{profile.nameZh}</span>
      </h1>
    </div><p>{profile.introduction}</p>
  </header>
  <section class="section page-shell">
    <SectionHeading
      eyebrow="Experience"
      title="Systems and product work"
    /><Timeline items={experience} />
  </section>
  <section class="section section-tint">
    <div class="page-shell">
      <SectionHeading
        eyebrow="Education"
        title="Training in ocean science"
      /><Timeline items={education} />
    </div>
  </section>
  <section class="section page-shell contact-block">
    <SectionHeading
      eyebrow="Elsewhere"
      title="Public profiles"
      description="Source code and the public research record are available through these profiles."
    /><div class="profile-links">
      {
        profile.links.map((link) => (
          <a class="button secondary" href={link.href}>
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
