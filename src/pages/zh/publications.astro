---
import PublicationList from '../../components/PublicationList.astro';
import { publications, siteContent } from '../../content/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
const { profile } = siteContent.zh;
const orcid = profile.links.find((link) => link.label === 'ORCID')?.href;
---

<BaseLayout
  locale="zh"
  title="论文 · 吴泽伦"
  description={`吴泽伦的完整同行评议论文记录，共 ${publications.length} 篇。`}
>
  <header class="page-intro page-shell">
    <p class="eyebrow">论文</p><h1>完整发表记录</h1><p>
      共 {publications.length} 篇同行评议论文，涉及海洋碳循环、遥感、物理海洋学和机器学习重建。论文题目保留正式发表时使用的英文原文。
    </p>{
      orcid && (
        <a class="text-link" href={orcid}>
          查看 ORCID <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </header>
  <section class="section page-shell">
    <PublicationList items={publications} locale="zh" />
  </section>
</BaseLayout>
